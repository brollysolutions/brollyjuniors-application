# Everything below has a working default. Copy to .env only to change something.

# --- postgres ---------------------------------------------------------------
DATABASE_URL=postgresql://brolly:brolly@127.0.0.1:5542/brolly_b2c

# --- redis ------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6479/0

# --- api --------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Signing keys are generated on first boot and kept in .data/keys so a restart
# does not sign everyone out. Back these up, or mount them from a secrets store.
