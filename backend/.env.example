# Everything below has a working default. Copy to .env only to change something.

# --- postgres ---------------------------------------------------------------
DATABASE_URL=postgresql://brolly:brolly@127.0.0.1:5542/brolly_b2c

# --- redis ------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6479/0

# --- api --------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Signing keys are generated on first boot and kept in .data/keys so a restart
# does not sign everyone out. Back these up, or mount them from a secrets store.

# --- mobile app -------------------------------------------------------------
# The Capacitor app is served off the device, so it is a different origin from
# the website and has to be named here (a credentialed request cannot be
# answered with "*"). Only consulted when NODE_ENV=production.
MOBILE_ORIGINS=capacitor://localhost,https://localhost,http://localhost

# The refresh cookie is same-site while a browser behind the Next proxy is the
# only client. The app makes it cross-site, and a cross-site cookie is only
# sent when it is SameSite=None — which requires Secure, so this API must then
# be on HTTPS. Set to none once you ship the app.
COOKIE_SAMESITE=lax
