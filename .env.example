# Everything below has a working default. Copy to .env only to change something.

# --- database ---------------------------------------------------------------
# pglite (default) runs a real PostgreSQL 16 in-process, no install, file-backed
# at .data/brolly. Switch to pg to point at a real server.
DB_DRIVER=pglite
# DATABASE_URL=postgres://brolly:brolly@localhost:5432/brolly

# --- api --------------------------------------------------------------------
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
# WEB_ORIGIN=https://app.brollyjuniors.com   # required in production for CORS

# Signing keys are generated on first boot and kept in .data/keys so a restart
# does not sign everyone out. Back these up, or mount them from a secrets store.
