# Copy to keystore.properties and fill in. That file is gitignored - never commit it.
#
# Create the keystore yourself so you, and only you, know the passwords:
#
#   keytool -genkeypair -v -keystore upload-keystore.jks \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# Back up the .jks AND the passwords somewhere durable. Google Play binds your
# listing to this key; lose it and you cannot ship an update to this app ever
# again. (Play App Signing gives a recovery path, but only if enrolled first.)

# Path to the .jks, relative to the android/ directory, or absolute.
storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
