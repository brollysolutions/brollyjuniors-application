# Where the FastAPI backend lives. Next rewrites /api/* to it, so the browser
# only ever talks to this origin.
API_ORIGIN=http://127.0.0.1:8300

# --- mobile (Capacitor) -----------------------------------------------------
# Only read by the mobile build (`npm run build:mobile`). The app has no Next
# server to proxy through, so it calls the API directly and needs its public
# origin. Inlined at build time, like every NEXT_PUBLIC_* value — changing it
# means rebuilding and re-running `npx cap sync`.
#
# Must be HTTPS for a shipped app: the refresh cookie is cross-site there, so
# it is SameSite=None, which browsers only accept with Secure.
NEXT_PUBLIC_API_BASE_URL=https://api.brollyjuniors.example
